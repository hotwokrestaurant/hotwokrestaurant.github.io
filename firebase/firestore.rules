rules_version = '2';

// Hot Wok Restaurant — Firestore security rules.
//
// How to publish: Firebase console → Firestore Database → Rules tab →
// replace everything with this file → Publish. (Details: firebase/README.md)
//
// What these rules allow:
//   • Anyone (customers, signed out) can READ the single menu document
//     menu/published. A signed-in account may also check its OWN admins entry.
//   • Only signed-in users listed in the "admins" collection (the owner) can
//     WRITE the menu, and only if the new data passes every check below.
//   • Everything else is denied. Firestore denies anything not allowed here.
//
// Menu sections (categories) are a map keyed by a permanent id (cat_…); dishes
// point to their section with category_id, so renaming a section never
// touches dishes.
//
// Two Firestore limits shape these rules:
//   1. Rules have no loops, so they can't check every dish or section in a
//      list. Each save checks only the dishes and sections that are NEW or
//      CHANGED compared with the saved menu: at most 3 dishes and at most
//      10 sections per save. Everything is therefore checked when written.
//   2. A rule may take at most 1,000 steps per request. The checks are written
//      to be cheap (one pattern per text, one lookup for "section exists"),
//      and a save that changes the sections can't also change dishes.
//      Measured in the Firestore emulator with 25 sections and 150 dishes:
//      every allowed kind of save fits.
//
// What the rules can NOT check cheaply (the admin page does it, inside the
// save transaction): that a deleted section has no dishes left, and that
// section names are unique. A dish whose section is missing is simply not
// shown on the customer menu.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- The owner allow-list ----------

    // A user is an admin if a document with their UID exists in "admins".
    // Those documents are created by hand in the Firebase console.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------- Settings (checked only when changed) ----------

    // Exactly these 8 fields: each one must exist with the right type, and the
    // count must be 8, so no unknown field can sneak in.
    function validSettings(s) {
      // Text is checked with one pattern each: .{1,60} = 1 to 60 characters
      // (fails for anything that isn't text). (?s) also allows line breaks.
      return s.keys().size() == 8
        && s.restaurant_name.matches('.{1,60}')
        && s.tagline.matches('.{0,80}')
        && s.phone.matches('.{0,30}')
        && s.address.matches('(?s).{0,150}')
        && s.opening_hours.matches('(?s).{0,150}')
        && s.notice.matches('.{0,120}')
        // Map link: empty, or an https:// address with no spaces (max 300).
        && s.map_url.matches('(https://[^ ]{1,292})?')
        && s.show_sold_out is bool;
    }

    // ---------- Menu sections (only new or changed ones are checked) ----------
    //
    // Sections are stored as a map keyed by their permanent id:
    //   categories: { "cat_kottu": { name, sort_order, visible }, … }
    // so "does this dish's section exist?" is one cheap lookup
    // (category_id in categories), however many sections there are.

    // Exactly 3 fields: name (1–30 characters), sort_order, visible.
    function validCategory(c) {
      return c.keys().size() == 3
        && c.name.matches('.{1,30}')
        && c.sort_order is int && c.sort_order >= 0 && c.sort_order <= 1000
        && c.visible is bool;
    }

    // True if position i is past the end of the list, or holds a valid section.
    function categoryAt(list, i) {
      return list.size() <= i || validCategory(list[i]);
    }

    // True if position i is past the end of the list, or holds a valid id.
    function categoryIdAt(ids, i) {
      return ids.size() <= i || ids[i].matches('cat_[a-z0-9]{4,20}');
    }

    // 1–25 sections. Every new or changed section is checked, and every new id
    // must look like "cat_…". At most 10 sections may change in one save.
    function validCategoryChanges(cats, oldCats) {
      let changed = cats.values().removeAll(oldCats.values());
      let newIds = cats.keys().removeAll(oldCats.keys());
      return cats.size() >= 1 && cats.size() <= 25
        && changed.size() <= 10 && newIds.size() <= 10
        && categoryAt(changed, 0) && categoryAt(changed, 1) && categoryAt(changed, 2)
        && categoryAt(changed, 3) && categoryAt(changed, 4) && categoryAt(changed, 5)
        && categoryAt(changed, 6) && categoryAt(changed, 7) && categoryAt(changed, 8)
        && categoryAt(changed, 9)
        && categoryIdAt(newIds, 0) && categoryIdAt(newIds, 1) && categoryIdAt(newIds, 2)
        && categoryIdAt(newIds, 3) && categoryIdAt(newIds, 4) && categoryIdAt(newIds, 5)
        && categoryIdAt(newIds, 6) && categoryIdAt(newIds, 7) && categoryIdAt(newIds, 8)
        && categoryIdAt(newIds, 9);
    }

    // ---------- Dishes (only new or changed ones are checked) ----------

    // 9 required fields + up to 3 optional ones (description, price_large,
    // image). Every field is type-checked, and the field count must match
    // exactly, so no unknown field can sneak in.
    function validItem(item, cats) {
      return item.keys().size() == 9
             + ('description' in item ? 1 : 0)
             + ('price_large' in item ? 1 : 0)
             + ('image' in item ? 1 : 0)
        // id like "itm_ko0001": lower-case letters/digits only.
        && item.id.matches('itm_[a-z0-9]{4,20}')
        // The dish's section must exist (one lookup in the sections map).
        && item.category_id in cats
        && item.name.matches('.{1,60}')
        && (!('description' in item) || item.description.matches('(?s).{0,150}'))
        // Prices are whole rupees: positive integers, at most 100,000.
        && item.price is int && item.price > 0 && item.price <= 100000
        // Large price: missing, null (= one size only), or a valid price.
        && (!('price_large' in item) || item.price_large == null
            || (item.price_large is int && item.price_large > 0 && item.price_large <= 100000))
        && item.spicy is bool && item.veg is bool
        && item.available is bool && item.featured is bool
        // Photo: missing, empty, or a simple file name in the repo's images/ folder.
        && (!('image' in item) || item.image.matches('([a-z0-9_-]{1,70}[.](webp|jpg|jpeg|png))?'))
        && item.sort_order is int && item.sort_order >= 0 && item.sort_order <= 10000;
    }

    // True if position i is past the end of the list, or holds a valid dish.
    function itemAt(items, i, cats) {
      return items.size() <= i || validItem(items[i], cats);
    }

    // ---------- The whole menu document ----------

    function validMenu() {
      let data = request.resource.data;
      let isNew = resource == null;
      // Dishes in the new menu that weren't in the saved menu, exactly as they
      // were (i.e. added or edited). Deleted dishes simply disappear.
      let changedItems = data.items.removeAll(isNew ? [] : resource.data.items);
      // Saved sections (empty when creating the menu, or when the saved menu
      // still uses the old list format, i.e. during the one-time upgrade).
      let oldCats = (isNew || !(resource.data.categories is map)) ? {} : resource.data.categories;

      // Exactly 4 top-level fields (each one is checked below).
      return data.keys().size() == 4
        // updatedAt must be the server's clock (serverTimestamp()), not the phone's.
        && data.updatedAt == request.time
        && ((!isNew && data.settings == resource.data.settings) || validSettings(data.settings))
        // A save that changes the sections (including creating the menu)
        // can't also add or change dishes: save section changes on their own.
        && data.categories is map
        && ((!isNew && data.categories == resource.data.categories)
            || (changedItems.size() == 0 && validCategoryChanges(data.categories, oldCats)))
        && data.items is list && data.items.size() <= 200
        && changedItems.size() <= 3
        && itemAt(changedItems, 0, data.categories)
        && itemAt(changedItems, 1, data.categories)
        && itemAt(changedItems, 2, data.categories);
    }

    // ---------- Access rules ----------

    // The published menu: one document, menu/published.
    match /menu/{docId} {
      // "get" = read one document by its name. Listing the collection is not allowed.
      allow get: if docId == 'published';
      allow create, update: if docId == 'published' && isAdmin() && validMenu();
      // No delete: the menu document should never disappear.
    }

    // The allow-list itself. Managed only in the Firebase console
    // (the console isn't limited by these rules).
    //   • A signed-in account may check ITS OWN entry (the admin page uses this
    //     to say "This account can't edit the menu"). It can't see anyone else's,
    //     and can't list the collection.
    //   • No app can create, change or delete entries — not even the owner's.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Anything not matched above is denied automatically.
  }
}
